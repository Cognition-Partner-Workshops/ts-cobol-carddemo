{
  "Comment": "CardDemo Monthly Interest Calculation - Migrated from Control-M MONTHLY-InterestCalculation folder. Runs on the 1st of each month. Executes CLOSEFIL -> INTCALC -> COMBTRAN -> WAITSTEP -> OPENFIL sequence. INTCALC runs CBACT04C.cbl to compute interest and fees on transaction category balances. COMBTRAN sorts and merges system-generated transactions with the daily backup using SORT utility.",
  "StartAt": "CLOSEFIL",
  "States": {
    "CLOSEFIL": {
      "Type": "Task",
      "Comment": "Close VSAM files in CICS for exclusive batch access. Corresponds to Control-M OUTCOND: MONTHLY-InterestCalculation-CLOSEFIL.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "CLOSEFIL.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.CloseFil",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitForCloseFil"
    },
    "WaitForCloseFil": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:m2:getBatchJobExecution",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "ExecutionId.$": "$.CloseFil.ExecutionId"
      },
      "ResultPath": "$.CloseFilStatus",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckCloseFilStatus"
    },
    "CheckCloseFilStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.CloseFilStatus.Status",
          "StringEquals": "Succeeded",
          "Next": "INTCALC"
        },
        {
          "Variable": "$.CloseFilStatus.Status",
          "StringEquals": "Failed",
          "Next": "MonthlyBatchFailed"
        },
        {
          "Variable": "$.CloseFilStatus.Status",
          "StringEquals": "Running",
          "Next": "CloseFilPollingWait"
        },
        {
          "Variable": "$.CloseFilStatus.Status",
          "StringEquals": "Dispatching",
          "Next": "CloseFilPollingWait"
        }
      ],
      "Default": "CloseFilPollingWait"
    },
    "CloseFilPollingWait": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "WaitForCloseFil"
    },
    "INTCALC": {
      "Type": "Task",
      "Comment": "Run interest calculations using CBACT04C.cbl. Reads TCATBALF-FILE (transaction category balances), XREF-FILE, ACCOUNT-FILE, DISCGRP-FILE. Writes computed interest/fee transactions to TRANSACT-FILE (GDG SYSTRAN). PARM specifies the processing date. Corresponds to Control-M INCOND: MONTHLY-InterestCalculation-CLOSEFIL, OUTCOND: MONTHLY-InterestCalculation-INTCALC.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "INTCALC.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.IntCalc",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitForIntCalc"
    },
    "WaitForIntCalc": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:m2:getBatchJobExecution",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "ExecutionId.$": "$.IntCalc.ExecutionId"
      },
      "ResultPath": "$.IntCalcStatus",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckIntCalcStatus"
    },
    "CheckIntCalcStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.IntCalcStatus.Status",
          "StringEquals": "Succeeded",
          "Next": "COMBTRAN"
        },
        {
          "Variable": "$.IntCalcStatus.Status",
          "StringEquals": "Failed",
          "Next": "EmergencyOpenFiles"
        },
        {
          "Variable": "$.IntCalcStatus.Status",
          "StringEquals": "Running",
          "Next": "IntCalcPollingWait"
        },
        {
          "Variable": "$.IntCalcStatus.Status",
          "StringEquals": "Dispatching",
          "Next": "IntCalcPollingWait"
        }
      ],
      "Default": "IntCalcPollingWait"
    },
    "IntCalcPollingWait": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "WaitForIntCalc"
    },
    "COMBTRAN": {
      "Type": "Task",
      "Comment": "Combine system-generated transactions (from INTCALC) with daily transaction backup using SORT utility. Sorts by TRAN-ID (position 1, length 16). Then loads the combined sorted file into the TRANSACT VSAM KSDS master via IDCAMS REPRO. Corresponds to Control-M INCOND: MONTHLY-InterestCalculation-INTCALC, OUTCOND: MONTHLY-InterestCalculation-COMBTRAN.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "COMBTRAN.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.CombTran",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitForCombTran"
    },
    "WaitForCombTran": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:m2:getBatchJobExecution",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "ExecutionId.$": "$.CombTran.ExecutionId"
      },
      "ResultPath": "$.CombTranStatus",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckCombTranStatus"
    },
    "CheckCombTranStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.CombTranStatus.Status",
          "StringEquals": "Succeeded",
          "Next": "WAITSTEP"
        },
        {
          "Variable": "$.CombTranStatus.Status",
          "StringEquals": "Failed",
          "Next": "EmergencyOpenFiles"
        },
        {
          "Variable": "$.CombTranStatus.Status",
          "StringEquals": "Running",
          "Next": "CombTranPollingWait"
        },
        {
          "Variable": "$.CombTranStatus.Status",
          "StringEquals": "Dispatching",
          "Next": "CombTranPollingWait"
        }
      ],
      "Default": "CombTranPollingWait"
    },
    "CombTranPollingWait": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "WaitForCombTran"
    },
    "WAITSTEP": {
      "Type": "Task",
      "Comment": "Safety delay via COBSWAIT (36 seconds). Corresponds to Control-M INCOND: MONTHLY-InterestCalculation-COMBTRAN, OUTCOND: MONTHLY-InterestCalculation-WAITSTEP.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "WAITSTEP.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.WaitStep",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitForWaitStep"
    },
    "WaitForWaitStep": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:m2:getBatchJobExecution",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "ExecutionId.$": "$.WaitStep.ExecutionId"
      },
      "ResultPath": "$.WaitStepStatus",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckWaitStepStatus"
    },
    "CheckWaitStepStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.WaitStepStatus.Status",
          "StringEquals": "Succeeded",
          "Next": "OPENFIL"
        },
        {
          "Variable": "$.WaitStepStatus.Status",
          "StringEquals": "Failed",
          "Next": "EmergencyOpenFiles"
        },
        {
          "Variable": "$.WaitStepStatus.Status",
          "StringEquals": "Running",
          "Next": "WaitStepPollingWait"
        },
        {
          "Variable": "$.WaitStepStatus.Status",
          "StringEquals": "Dispatching",
          "Next": "WaitStepPollingWait"
        }
      ],
      "Default": "WaitStepPollingWait"
    },
    "WaitStepPollingWait": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "WaitForWaitStep"
    },
    "OPENFIL": {
      "Type": "Task",
      "Comment": "Reopen VSAM files in CICS. Corresponds to Control-M INCOND: MONTHLY-InterestCalculation-WAITSTEP. Final step in the monthly interest calculation cycle.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "OPENFIL.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.OpenFil",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitForOpenFil"
    },
    "WaitForOpenFil": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:m2:getBatchJobExecution",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "ExecutionId.$": "$.OpenFil.ExecutionId"
      },
      "ResultPath": "$.OpenFilStatus",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckOpenFilStatus"
    },
    "CheckOpenFilStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.OpenFilStatus.Status",
          "StringEquals": "Succeeded",
          "Next": "MonthlyBatchSucceeded"
        },
        {
          "Variable": "$.OpenFilStatus.Status",
          "StringEquals": "Failed",
          "Next": "MonthlyBatchFailed"
        },
        {
          "Variable": "$.OpenFilStatus.Status",
          "StringEquals": "Running",
          "Next": "OpenFilPollingWait"
        },
        {
          "Variable": "$.OpenFilStatus.Status",
          "StringEquals": "Dispatching",
          "Next": "OpenFilPollingWait"
        }
      ],
      "Default": "OpenFilPollingWait"
    },
    "OpenFilPollingWait": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "WaitForOpenFil"
    },
    "EmergencyOpenFiles": {
      "Type": "Task",
      "Comment": "Emergency recovery: reopen VSAM files after a mid-batch failure to prevent CICS from being locked out indefinitely.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "OPENFIL.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.EmergencyOpenFil",
      "Next": "MonthlyBatchFailed"
    },
    "MonthlyBatchSucceeded": {
      "Type": "Succeed",
      "Comment": "Monthly interest calculation cycle completed successfully."
    },
    "MonthlyBatchFailed": {
      "Type": "Fail",
      "Error": "MonthlyBatchError",
      "Cause": "One or more jobs in the monthly interest calculation cycle failed. Check CloudWatch logs for details."
    }
  }
}
