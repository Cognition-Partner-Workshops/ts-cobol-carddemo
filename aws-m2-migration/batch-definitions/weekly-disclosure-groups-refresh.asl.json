{
  "Comment": "CardDemo Weekly Disclosure Groups Refresh - Migrated from Control-M SMART_FOLDER WEEKLY-DisclosureGroupsRefresh. Runs on Saturdays after MNTTRDB2 completes. Executes CLOSEFIL -> DISCGRP -> WAITSTEP -> OPENFIL sequence. Depends on WEEKLY-TransactionTypesDBRefresh completing first (cross-workflow dependency via MNTTRDB2 OUTCOND).",
  "StartAt": "CLOSEFIL",
  "States": {
    "CLOSEFIL": {
      "Type": "Task",
      "Comment": "Close VSAM files in CICS for exclusive batch access. Corresponds to Control-M INCOND: WEEKLY-TransactionTypesDBRefresh-MNTTRDB2, OUTCOND: WEEKLY-DisclosureGroupsRefresh-CLOSEFIL.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "CLOSEFIL.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.CloseFil",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitForCloseFil"
    },
    "WaitForCloseFil": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:m2:getBatchJobExecution",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "ExecutionId.$": "$.CloseFil.ExecutionId"
      },
      "ResultPath": "$.CloseFilStatus",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckCloseFilStatus"
    },
    "CheckCloseFilStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.CloseFilStatus.Status",
          "StringEquals": "Succeeded",
          "Next": "DISCGRP"
        },
        {
          "Variable": "$.CloseFilStatus.Status",
          "StringEquals": "Failed",
          "Next": "WeeklyDisclosureFailed"
        },
        {
          "Variable": "$.CloseFilStatus.Status",
          "StringEquals": "Running",
          "Next": "CloseFilPollingWait"
        },
        {
          "Variable": "$.CloseFilStatus.Status",
          "StringEquals": "Dispatching",
          "Next": "CloseFilPollingWait"
        }
      ],
      "Default": "CloseFilPollingWait"
    },
    "CloseFilPollingWait": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "WaitForCloseFil"
    },
    "DISCGRP": {
      "Type": "Task",
      "Comment": "Refresh Disclosure Group VSAM file. Deletes existing DISCGRP.VSAM.KSDS cluster, redefines it, then REPROs flat file data into VSAM. Corresponds to Control-M INCOND: WEEKLY-DisclosureGroupsRefresh-CLOSEFIL, OUTCOND: WEEKLY-DisclosureGroupsRefresh-DISCGRP.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "DISCGRP.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.DiscGrp",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitForDiscGrp"
    },
    "WaitForDiscGrp": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:m2:getBatchJobExecution",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "ExecutionId.$": "$.DiscGrp.ExecutionId"
      },
      "ResultPath": "$.DiscGrpStatus",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckDiscGrpStatus"
    },
    "CheckDiscGrpStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.DiscGrpStatus.Status",
          "StringEquals": "Succeeded",
          "Next": "WAITSTEP"
        },
        {
          "Variable": "$.DiscGrpStatus.Status",
          "StringEquals": "Failed",
          "Next": "EmergencyOpenFiles"
        },
        {
          "Variable": "$.DiscGrpStatus.Status",
          "StringEquals": "Running",
          "Next": "DiscGrpPollingWait"
        },
        {
          "Variable": "$.DiscGrpStatus.Status",
          "StringEquals": "Dispatching",
          "Next": "DiscGrpPollingWait"
        }
      ],
      "Default": "DiscGrpPollingWait"
    },
    "DiscGrpPollingWait": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "WaitForDiscGrp"
    },
    "WAITSTEP": {
      "Type": "Task",
      "Comment": "Safety delay via COBSWAIT (36 seconds). Corresponds to Control-M INCOND: WEEKLY-DisclosureGroupsRefresh-DISCGRP, OUTCOND: WEEKLY-DisclosureGroupsRefresh-WAITSTEP.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "WAITSTEP.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.WaitStep",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitForWaitStep"
    },
    "WaitForWaitStep": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:m2:getBatchJobExecution",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "ExecutionId.$": "$.WaitStep.ExecutionId"
      },
      "ResultPath": "$.WaitStepStatus",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckWaitStepStatus"
    },
    "CheckWaitStepStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.WaitStepStatus.Status",
          "StringEquals": "Succeeded",
          "Next": "OPENFIL"
        },
        {
          "Variable": "$.WaitStepStatus.Status",
          "StringEquals": "Failed",
          "Next": "EmergencyOpenFiles"
        },
        {
          "Variable": "$.WaitStepStatus.Status",
          "StringEquals": "Running",
          "Next": "WaitStepPollingWait"
        },
        {
          "Variable": "$.WaitStepStatus.Status",
          "StringEquals": "Dispatching",
          "Next": "WaitStepPollingWait"
        }
      ],
      "Default": "WaitStepPollingWait"
    },
    "WaitStepPollingWait": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "WaitForWaitStep"
    },
    "OPENFIL": {
      "Type": "Task",
      "Comment": "Reopen VSAM files in CICS. Corresponds to Control-M INCOND: WEEKLY-DisclosureGroupsRefresh-WAITSTEP. Final step in the disclosure groups refresh cycle.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "OPENFIL.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.OpenFil",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitForOpenFil"
    },
    "WaitForOpenFil": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:m2:getBatchJobExecution",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "ExecutionId.$": "$.OpenFil.ExecutionId"
      },
      "ResultPath": "$.OpenFilStatus",
      "Retry": [
        {
          "ErrorEquals": ["M2.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 5,
          "BackoffRate": 2.0
        }
      ],
      "Next": "CheckOpenFilStatus"
    },
    "CheckOpenFilStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.OpenFilStatus.Status",
          "StringEquals": "Succeeded",
          "Next": "WeeklyDisclosureSucceeded"
        },
        {
          "Variable": "$.OpenFilStatus.Status",
          "StringEquals": "Failed",
          "Next": "WeeklyDisclosureFailed"
        },
        {
          "Variable": "$.OpenFilStatus.Status",
          "StringEquals": "Running",
          "Next": "OpenFilPollingWait"
        },
        {
          "Variable": "$.OpenFilStatus.Status",
          "StringEquals": "Dispatching",
          "Next": "OpenFilPollingWait"
        }
      ],
      "Default": "OpenFilPollingWait"
    },
    "OpenFilPollingWait": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "WaitForOpenFil"
    },
    "EmergencyOpenFiles": {
      "Type": "Task",
      "Comment": "Emergency recovery: reopen VSAM files after a mid-batch failure.",
      "Resource": "arn:aws:states:::aws-sdk:m2:startBatchJob",
      "Parameters": {
        "ApplicationId.$": "$.ApplicationId",
        "BatchJobIdentifier": {
          "FileBatchJobIdentifier": {
            "FileName": "OPENFIL.jcl",
            "FolderPath": "/m2/data/jcl"
          }
        }
      },
      "ResultPath": "$.EmergencyOpenFil",
      "Next": "WeeklyDisclosureFailed"
    },
    "WeeklyDisclosureSucceeded": {
      "Type": "Succeed",
      "Comment": "Weekly disclosure groups refresh completed successfully."
    },
    "WeeklyDisclosureFailed": {
      "Type": "Fail",
      "Error": "WeeklyDisclosureError",
      "Cause": "One or more jobs in the weekly disclosure groups refresh cycle failed. Check CloudWatch logs for details."
    }
  }
}
