{
  "group": "ims-mq",
  "baseline": "baseline/sdd-2610",
  "scope": "Every COBOL program under app/app-authorization-ims-db2-mq/cbl and app/app-vsam-mq/cbl, with IMS DBDs/PSBs, MQ queues, Db2 tables, JCL steps and CICS transactions from the same modules. Inventory only.",
  "complexity_convention": {
    "formula": "paragraphs + 2 x file_io_verbs + 3 x external_calls",
    "paragraphs": "paragraph and section labels in Area A of the PROCEDURE DIVISION",
    "file_io_verbs": "occurrences in the PROCEDURE DIVISION (comments and literals excluded) of COBOL OPEN/CLOSE/READ/WRITE/REWRITE/DELETE/START, EXEC CICS file commands (READ, WRITE, REWRITE, DELETE, UNLOCK, STARTBR, READNEXT, READPREV, RESETBR, ENDBR), executable EXEC SQL statements (INCLUDE/DECLARE/WHENEVER excluded), DL/I calls (EXEC DLI and CALL 'CBLTDLI', including SCHD/TERM/CHKP) and MQ API calls (MQOPEN, MQGET, MQPUT, MQPUT1, MQCLOSE)",
    "external_calls": "distinct targets of CALL (other than CBLTDLI and MQ API, counted as I/O), EXEC CICS XCTL and LINK; XCTL PROGRAM(CDEMO-TO-PROGRAM) resolved to the literal targets MOVEd into it",
    "bands": {
      "low": "score < 40",
      "medium": "40 <= score < 80",
      "high": "score >= 80"
    }
  },
